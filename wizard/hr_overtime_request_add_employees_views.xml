<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_overtime_request_add_employees_form" model="ir.ui.view">
        <field name="name">hr.overtime.request.add.employees.form</field>
        <field name="model">hr.overtime.request.add.employees</field>
        <field name="arch" type="xml">
            <form string="Add Employees">
                <group>
                    <field name="existing_employee_ids" invisible="1"/>
                    <field name="employee_ids" widget="many2many_tags" domain="[('id', 'not in', existing_employee_ids)]" context="{'search_default_group_department': 1}" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_add_employees" string="Add" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_overtime_request_add_employees" model="ir.actions.act_window">
        <field name="name">Add Employees</field>
        <field name="res_model">hr.overtime.request.add.employees</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
