        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="domain_force">[('shift_request_id.state', '=', 'draft'),'|',
            ('employee_id.coach_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=',
            user.id)]</field>
    </record>


    <record id="hr_shift_request_line_rule_hr_shift_admin" model="ir.rule">
        <field name="name">HR Shift Request Line admin Rule</field>
        <field name="model_id" ref="model_hr_shift_request_line" />
