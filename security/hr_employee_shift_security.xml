        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="domain_force">['|', ('employee_id.coach_id.user_id', '=', user.id),
            ('employee_id.parent_id.user_id', '=', user.id)]</field>
    </record>
    <record id="hr_shift_request_line_rule_hr_shift_manager_draft" model="ir.rule">
        <field name="name">HR Shift Request Line Manager Rule Draft</field>
        <field name="model_id" ref="model_hr_shift_request_line" />
        <field name="groups"
