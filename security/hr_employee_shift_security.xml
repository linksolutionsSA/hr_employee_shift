<?xml version="1.0"?>
<odoo>
    <record id="module_category_human_resources_shift" model="ir.module.category">
        <field name="name">Shifts</field>
        <field name="description">Helps you manage employee shifts.</field>
        <field name="parent_id" ref="base.module_category_human_resources" />
        <field name="sequence">90</field>
    </record>

    <record id="group_hr_shift_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_human_resources_shift" />
        <field name="comment">A user can only see his/her own shifts.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_hr_shift_manager" model="res.groups">
        <field name="name">Manager Deparment/Company</field>
        <field name="category_id" ref="module_category_human_resources_shift" />
        <field name="comment">A manager can see and submit shift requests for employees in his/her
            department or company.</field>
        <field name="implied_ids" eval="[(4, ref('hr_employee_shift.group_hr_shift_user'))]" />
    </record>

    <record id="group_hr_shift_admins" model="res.groups">
        <field name="name">Adminstrator</field>
        <field name="category_id" ref="module_category_human_resources_shift" />
        <field name="comment">System Administrators</field>
        <field name="implied_ids"
            eval="[(4, ref('hr_employee_shift.group_hr_shift_manager'))]" />
        <field name="users" eval="[(4, ref('base.user_admin'))]" />
    </record>


    <!-- Rules for hr.shift.schedule -->
    <record id="hr_shift_schedule_rule_user" model="ir.rule">
        <field name="name">HR Shift Schedule User Rule</field>
        <field name="model_id" ref="model_hr_shift_schedule" />
        <field name="groups" eval="[(4, ref('hr_employee_shift.group_hr_shift_user'))]" />
        <field name="domain_force">
            [("employee_id.user_id", "=", user.id)]
        </field>
    </record>

    <record id="hr_shift_schedule_rule_hr_shift_manager" model="ir.rule">
        <field name="name">HR Shift Schedule Manager Rule</field>
        <field name="model_id" ref="model_hr_shift_schedule" />
        <field name="groups"
            eval="[(4, ref('hr_employee_shift.group_hr_shift_manager'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="domain_force">['|', '|' , ('employee_id.user_id', '=',
            user.id),('employee_id.parent_id.user_id', '=', user.id), ('employee_id.user_id', '=',
            False)]</field>
    </record>


    <record id="hr_shift_schedule_rule_hr_shift_admins" model="ir.rule">
        <field name="name">HR Shift Schedule Company Manager Rule</field>
        <field name="model_id" ref="model_hr_shift_schedule" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_employee_shift.group_hr_shift_admins'))]" />
    </record>

    <!-- Rules for hr.shift.request -->
    <record id="hr_shift_request_rule_user" model="ir.rule">
        <field name="name">HR Shift Request User Rule</field>
        <field name="model_id" ref="model_hr_shift_request" />
        <field name="groups" eval="[(4, ref('hr_employee_shift.group_hr_shift_user'))]" />
        <field name="domain_force">
            [("shift_request_line_ids.employee_id.user_id", "=", user.id)]
        </field>
    </record>

    <record id="hr_shift_request_rule_hr_shift_manager" model="ir.rule">
        <field name="name">HR Shift Request Manager Rule</field>
        <field name="model_id" ref="model_hr_shift_request" />
        <field name="groups"
            eval="[(4, ref('hr_employee_shift.group_hr_shift_manager'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="domain_force">["|", "|",
            ("shift_request_line_ids.employee_id.coach_id.user_id", "=", user.id),
            ("shift_request_line_ids.employee_id.parent_id.user_id", "=", user.id), "&amp;",
            ("shift_request_line_ids", "=", False), ("company_id", "in",
            user.company_ids.ids)]</field>
    </record>
    <record id="hr_shift_request_rule_hr_shift_manager_draft" model="ir.rule">
        <field name="name">HR Shift Request Manager Rule Draft</field>
        <field name="model_id" ref="model_hr_shift_request" />
        <field name="groups"
            eval="[(4, ref('hr_employee_shift.group_hr_shift_manager'))]" />
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="True" />
        <field name="domain_force">[('state', '=', 'draft'),'|','|',
            ('shift_request_line_ids.employee_id.coach_id.user_id', '=', user.id),
            ('shift_request_line_ids.employee_id.parent_id.user_id', '=',
            user.id),"&amp;",("shift_request_line_ids", "=", False), ("company_id", "in",
            user.company_ids.ids)]</field>
    </record>


    <record id="hr_shift_request_rule_hr_shift_admins" model="ir.rule">
        <field name="name">HR Shift Request Admin</field>
        <field name="model_id" ref="model_hr_shift_request" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_employee_shift.group_hr_shift_admins'))]" />
    </record>


