<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited the form view of hr.contract -->
    <record id="hr_contract_view_form" model="ir.ui.view">
        <field name="name">hr.contract.view.form.inherit.hr.employee.shift</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form" />
        <field name="arch" type="xml">
            <!-- <xpath expr="//field[@name='resource_calendar_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath> -->
            <!-- add page to the notebook -->

            <xpath expr="//notebook" position="inside">
                <page string="Shifts/Overtimes">
                    <field name="shift_schedule" nolabel="1">
                        <list editable="bottom">
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="hr_shift" />
                            <field name="day_off" />
                        </list>
                    </field>
                    <field name="overtime_schedule" nolabel="1" readonly="1">
                        <list editable="bottom">
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="overtime_hours" widget="float_time"
                                string="Allowed Overtime Hours" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>