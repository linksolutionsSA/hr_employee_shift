<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_overtime_request_view_calendar"
        model="ir.ui.view">
        <field name="name">hr.overtime.request.calendar</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch"
            type="xml">
            <calendar string="Overtime Schedule"
                date_start="start_date"
                date_stop="end_date"
                mode="month"
                color="calendar_color"
                quick_create="0"
                event_open_popup="true">
                <field name="state"
                    decoration-success="state == 'approved'"
                    decoration-danger="state == 'rejected'"
                    filters="1" />
                <field name="name" />
                <field name="overtime_request_line_ids"
                    widget="one2many_list" />
                <field name="overtime_hours" />
                <field name="company_id"
                    filters="1" />
                <field name="justification" />
                <field name="total_cost_of_overtime" />
                <field name="existing_employee_department_ids" />
            </calendar>
        </field>
    </record>

    <record id="hr_overtime_request_view_tree"
        model="ir.ui.view">
        <field name="name">hr.overtime.request.view.tree</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch"
            type="xml">
            <list string="Overtime Requests">
                <field name="name" />
                <field name="justification" />
                <field name="overtime_hours" />
                <field name="state"
                    decoration-success="state == 'approved'"
                    decoration-danger="state == 'rejected'" />
                <field name="total_cost_of_overtime" />

            </list>
        </field>
    </record>

    <record id="hr_overtime_request_view_form"
        model="ir.ui.view">
        <field name="name">hr.overtime.request.view.form</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch"
            type="xml">
            <form string="Overtime Request">
                <header>
                    <button name="action_submit"
                        string="Submit"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'draft'" />
                    <button name="action_approve"
                        string="Approve"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'to_approve'"
                        groups="hr.group_hr_manager" />
                    <button name="action_reject"
                        string="Reject"
                        type="object"
                        invisible="state != 'to_approve'"
                        groups="hr.group_hr_manager" />
                    <button name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="state not in ['to_approve']" />
                    <field name="state"
                        widget="statusbar"
                        statusbar_visible="draft,to_approve,approved,rejected"
                        readonly="True" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                readonly="True" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="start_date"
                                readonly="state != 'draft'" />
                            <field name="end_date"
                                readonly="state != 'draft'" />
                            <field name="approved_by_id" />
                            <field name="justification"
                                placeholder="Please justify your overtime request .."
                                rows="3"
                                readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field name="overtime_hours"
                                widget="float_time"
                                readonly="state != 'draft'"
                                string="Overtime Hours Per Day" />
                            <field name="total_overtime_hours"
                                widget="float_time"
                                readonly="1"
                                string="Total Overtime Hours Per Person" />
                            <field name="company_id"
                                readonly="state != 'draft'" />
                            <field name="department_id"
                                readonly="state != 'draft'"
                                domain="[('company_id', '=', company_id)]" />
                            <field name="total_cost_of_overtime"
                                readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Employees Lines">
                            <field name="existing_overtime_request_line_ids"
                                invisible="1" />
                            <button name="%(action_hr_overtime_request_add_employees)d"
                                string="Add Employees"
                                type="action"
                                class="oe_highlight"
                                context="{'default_overtime_request_id': id}"
                                invisible="state != 'draft'" />
                            <field name="overtime_request_line_ids"
                                readonly="state != 'draft'">
                                <list create="false">
                                    <field name="employee_id"
                                        domain="[('id', 'not in', parent.existing_overtime_request_line_ids)]" />
                                    <field name="cost_of_overtime"
                                        readonly="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="hr_overtime_request_view_search"
        model="ir.ui.view">
        <field name="name">hr.overtime.request.search</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch"
            type="xml">
            <search string="Search Overtime Requests">
                <searchpanel>
                    <field name="company_id"
                        string="Company"
                        select="multi"
                        enable_counters="1" />
                    <field name="existing_employee_department_ids"
                        string="Employee Department"
                        enable_counters="1"
                        select="multi"
                        icon="fa-building" />
                </searchpanel>
                <field name="overtime_request_line_ids"
                    string="Employee Name/BadgID/Iqama"
                    filter_domain="['|', '|', ('overtime_request_line_ids.employee_id.name', 'ilike', self), ('overtime_request_line_ids.employee_id.barcode', '=', self), ('overtime_request_line_ids.employee_id.identification_id', '=', self)]" />
                <field name="name"
                    string="Reference" />
                <field name="state" />
                <filter string="Department"
                    name="group_by_department"
                    context="{'group_by': 'department_id'}" />
            </search>
        </field>
    </record>

    <record id="hr_overtime_request_action"
        model="ir.actions.act_window">
        <field name="name">Overtime Requests</field>
        <field name="res_model">hr.overtime.request</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="domain">[('company_id', 'in', context.get('allowed_company_ids'))]</field>
    </record>

    <menuitem id="hr_overtime_request_menu"
        name="Overtime Requests"
        action="hr_overtime_request_action"
        parent="hr_employee_shift.menu_shift"
        groups="hr_employee_shift.group_hr_shift_manager,hr_employee_shift.group_hr_shift_admins"
        sequence="3" />
</odoo>